{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":separateMultipleMajorReleases",
    ":timezone(Europe/Berlin)"
  ],

  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,

  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },

  "helm-values": {
    "description": "Scan values.yaml files",
    "managerFilePatterns": ["/(^|/)values-.+\\.ya?ml$/"]
  },

  "argocd": {
    "description": "Scan Argo CD Applications",
    "managerFilePatterns": ["/^bootstrap/.+\\.ya?ml$/"]
  },

  "hostRules": [
    {
      "matchHost": "docker.io",
      "username": "{{ secrets.DOCKERHUB_USERNAME }}",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    }
  ],

  "packageRules": [
    {
      "description": "Automerge patch, pin and digest updates for all packages.",
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest"],
      "labels": ["dependencies", "non-major"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates for stable (>= 1.0.0) packages.",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^v?0/",
      "labels": ["dependencies", "non-major"],
      "automerge": true
    },
    {
      "description": "Disable automerge for Argo CD for minor and major updates.",
      "matchPackageNames": ["/argoproj/argo-cd/"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "git.nentwich.dev images are owned by argocd-image-updater",
      "matchPackageNames": ["git.nentwich.dev/**"],
      "enabled": false
    },
    {
      "description": "The Forgejo chart appends -rootless after the tag, so a digest inside the tag breaks the image reference",
      "matchPackageNames": ["code.forgejo.org/forgejo/forgejo"],
      "pinDigests": false
    },
    {
      "description": "Semver pre-releases (beta38 → rc.2 → 1.0.0), not Docker compatibility suffixes",
      "matchPackageNames": ["ghcr.io/pelican/panel"],
      "versioning": "semver"
    }
  ]
}
