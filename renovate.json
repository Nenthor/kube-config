{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Berlin",
  "labels": ["dependencies"],

  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",

  "helm-values": {
    "description": "Scan values.yaml files",
    "managerFilePatterns": ["/(^|/)values-.+\\.ya?ml$/"]
  },

  "hostRules": [
    {
      "matchHost": "docker.io",
      "username": "{{ secrets.DOCKERHUB_USERNAME }}",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    }
  ],

  "vulnerabilityAlerts": {
    "description": "Security fixes skip the release-age hold and merge whenever.",
    "labels": ["security"],
    "minimumReleaseAge": "0 days",
    "automerge": true,
    "schedule": ["at any time"]
  },

  "packageRules": [
    {
      "description": "Automerge all patch updates.",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates for stable (>= 1.0.0) packages.",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ]
}
